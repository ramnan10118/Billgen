# Google Sheets API Configuration
# Copy this file to .env and fill in your values

# Your Google Sheet ID (from the URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit)
VITE_GOOGLE_SHEET_ID=your_sheet_id_here

# Your Google API Key (from Google Cloud Console)
VITE_GOOGLE_API_KEY=your_api_key_here

# The range to read from (default: Sheet1!A:A)
VITE_SHEET_RANGE=Sheet1!A:A

# Google Sign-In — OAuth 2.0 Web client ID (same value for both)
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Optional: local API base (default empty = same origin in production)
# VITE_API_URL=http://localhost:3001
