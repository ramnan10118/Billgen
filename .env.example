# Copy this file to .env and fill in your values.

# --- Google Sheets (service account — backend DB) ---
GOOGLE_SHEET_ID=your_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=billgen-sheets@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Google Sign-In (OAuth 2.0 Web client ID — same value for both) ---
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# --- Email (Resend) ---
RESEND_API_KEY=re_your_key_here

# --- App URLs ---
# Base URL used in magic/download links. Prod: https://ravenlog.in
VITE_APP_URL=https://ravenlog.in
# Local API base (default empty = same origin in production)
# VITE_API_URL=http://localhost:3001

# --- Cron auth (Vercel cron injects `Authorization: Bearer ${CRON_SECRET}`) ---
CRON_SECRET=your_random_secret

# --- Launch flags ---
# FREE_MODE=true → whole app free (everyone treated as subscribed: no paywall,
# no upsells, monthly delivery serves all). Unset/false to resume charging.
FREE_MODE=true
# SKIP_SUBSCRIPTION_GATE=true → cron-only bypass of the paid delivery gate
# (superseded by FREE_MODE for a full free launch; kept for targeted testing).
# SKIP_SUBSCRIPTION_GATE=true

# --- Razorpay (dormant while FREE_MODE is on; required to charge) ---
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_secret
RAZORPAY_PLAN_ID=plan_xxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# --- Data source (sheets | supabase). supabase not yet implemented ---
# DATA_SOURCE=sheets
